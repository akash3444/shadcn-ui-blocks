{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "item-05",
  "title": "Item with Avatar",
  "description": "An item with an avatar and actions",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "item",
    "avatar",
    "button"
  ],
  "files": [
    {
      "path": "src/components/customized/item/item-05.tsx",
      "content": "import { MailIcon, MoreHorizontalIcon } from \"lucide-react\";\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/registry/ui/avatar\";\nimport { Button } from \"@/registry/ui/button\";\nimport {\n  Item,\n  ItemActions,\n  ItemContent,\n  ItemDescription,\n  ItemMedia,\n  ItemTitle,\n} from \"@/registry/ui/item\";\n\nexport default function ItemWithAvatarDemo() {\n  return (\n    <div className=\"w-full max-w-md\">\n      <Item variant=\"outline\">\n        <ItemMedia>\n          <Avatar className=\"size-10\">\n            <AvatarImage\n              alt=\"Olivia Martin\"\n              src=\"https://randomuser.me/api/portraits/women/44.jpg\"\n            />\n            <AvatarFallback>OM</AvatarFallback>\n          </Avatar>\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>Olivia Martin</ItemTitle>\n          <ItemDescription>olivia.martin@example.com</ItemDescription>\n        </ItemContent>\n        <ItemActions>\n          <Button aria-label=\"Send email\" size=\"icon-sm\" variant=\"ghost\">\n            <MailIcon />\n          </Button>\n          <Button aria-label=\"More options\" size=\"icon-sm\" variant=\"ghost\">\n            <MoreHorizontalIcon />\n          </Button>\n        </ItemActions>\n      </Item>\n    </div>\n  );\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}