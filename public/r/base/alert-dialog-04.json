{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "alert-dialog-04",
  "title": "Info Alert Dialog",
  "description": "An info alert dialog component",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "alert-dialog",
    "button",
    "badge"
  ],
  "files": [
    {
      "path": "src/components/customized/alert-dialog/alert-dialog-04.tsx",
      "content": "import { CircleCheckIcon, CircleFadingArrowUp } from \"lucide-react\";\nimport {\n  AlertDialog,\n  AlertDialogAction,\n  AlertDialogCancel,\n  AlertDialogContent,\n  AlertDialogDescription,\n  AlertDialogFooter,\n  AlertDialogHeader,\n  AlertDialogMedia,\n  AlertDialogTitle,\n  AlertDialogTrigger,\n} from \"@/registry/ui/alert-dialog\";\nimport { Button } from \"@/registry/ui/button\";\n\nexport default function AlertDialogInfo() {\n  return (\n    <AlertDialog>\n      <AlertDialogTrigger asChild>\n        <Button variant=\"outline\">Show Dialog</Button>\n      </AlertDialogTrigger>\n      <AlertDialogContent size=\"sm\">\n        <AlertDialogHeader>\n          <AlertDialogMedia>\n            <CircleFadingArrowUp />\n          </AlertDialogMedia>\n          <AlertDialogTitle>Update available</AlertDialogTitle>\n          <AlertDialogDescription>\n            Install version 2.4 to get the latest improvements.\n          </AlertDialogDescription>\n        </AlertDialogHeader>\n        <div className=\"mx-auto flex max-w-max flex-col gap-2 text-sm\">\n          <div className=\"flex items-center gap-2\">\n            <CircleCheckIcon className=\"size-4 shrink-0 fill-muted text-muted-foreground\" />\n            Faster performance\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <CircleCheckIcon className=\"size-4 shrink-0 fill-muted text-muted-foreground\" />\n            Refreshed interface\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <CircleCheckIcon className=\"size-4 shrink-0 fill-muted text-muted-foreground\" />\n            Security and stability fixes\n          </div>\n        </div>\n        <AlertDialogFooter>\n          <AlertDialogCancel>Later</AlertDialogCancel>\n          <AlertDialogAction>Update now</AlertDialogAction>\n        </AlertDialogFooter>\n      </AlertDialogContent>\n    </AlertDialog>\n  );\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}